# PostgreSQL connection string (Neon recommended in production; use the pooled URL on Vercel)
DATABASE_URL=

# Generate each with: openssl rand -base64 64   (must be different values, >= 32 chars)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Vercel Blob store (PRIVATE store). Server-only — never prefix with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Upload limit in megabytes
MAX_DOCUMENT_SIZE_MB=25

# Public origin of the app, used for CSRF Origin checks (e.g. https://docs.example.com).
# Optional: when empty the request Host is used.
APP_URL=

# Bearer secret Vercel Cron sends to /api/cron/cleanup (openssl rand -base64 32)
CRON_SECRET=

# Optional rate-limit overrides (defaults shown)
# RATE_LIMIT_LOGIN_FAILURES=5          # per IP+account per 15 minutes
# RATE_LIMIT_LOGIN_IP=50               # per IP per 15 minutes
# RATE_LIMIT_SIGNUP_IP=10              # per IP per hour
# RATE_LIMIT_UPLOADS=10                # per user per hour
# RATE_LIMIT_VIEW=600                  # content requests per user per 10 minutes
# RATE_LIMIT_DELETE=60                 # per user per hour
# RATE_LIMIT_REFRESH=60                # per IP per 15 minutes
# RATE_LIMIT_SHARES=30                 # share attempts per user per hour

NODE_ENV=development
